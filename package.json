{
  "name": "app-lantern",
  "version": "1.2.1",
  "private": true,
  "description": "Lantern — serve a whole library of offline content over the LAN. Zero runtime dependencies.",
  "author": {
    "name": "Dr Sohil Momin",
    "email": "sohilmomin2000@gmail.com"
  },
  "homepage": "https://drsamonline.github.io/app-lantern/",
  "license": "SEE LICENSE IN LICENSE",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node server.js",
    "test": "node test-node.js",
    "desktop": "electron .",
    "dist:linux": "electron-builder --linux",
    "dist:win": "electron-builder --win"
  },
  "main": "desktop/main.js",
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "io.github.drsamonline.lantern",
    "productName": "Lantern",
    "directories": {
      "output": "release"
    },
    "files": [
      "desktop/**",
      "server.js",
      "lib/**",
      "public/**",
      "examples/**",
      "start-lantern.bat",
      "start-lantern.sh",
      "LICENSE",
      "README.md",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Education"
    }
  }
}
